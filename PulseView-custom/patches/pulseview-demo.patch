+		connect(probe, &QTimer::timeout, this, [this, weak_session, report_path]() {
+			auto current = weak_session.lock();
+			if (!current || current->get_capture_state() != Session::Stopped) return;
+			QJsonArray decoders, channels;
+			for (auto base : current->signalbases()) {
+				auto decode = dynamic_pointer_cast<data::DecodeSignal>(base);
+				if (!decode) { channels.append(base->name()); continue; }
+				QJsonArray texts;
+				std::deque<const data::decode::Annotation*> annotations;
+				decode->get_annotation_subset(annotations, 0, 0, std::numeric_limits<uint64_t>::max());
+				for (auto annotation : annotations) {
+					QJsonObject value;
+					value["class"] = annotation->ann_class_name();
+					value["text"] = annotation->longest_annotation();
+					value["visible"] = annotation->visible();
+					value["sample"] = double(annotation->start_sample());
+					texts.append(value);
+				}
+				QJsonObject item;
+				item["name"] = base->name();
+				item["annotations"] = texts;
+				decoders.append(item);
+			}
+			QJsonObject report;
+			report["session"] = current->name();
+			if (current->device()) report["device"] = QString::fromStdString(current->device()->display_name(device_manager_));
+			auto hw = dynamic_pointer_cast<devices::HardwareDevice>(current->device());
+			if (hw && hw->hardware_device()->driver()->name() == "rp2350-la") {
+				auto dev = hw->hardware_device();
+				QJsonObject config;
+				try {
+					config["samplerate"] = double(g_variant_get_uint64(dev->config_get(sigrok::ConfigKey::SAMPLERATE).gobj()));
+					config["samples"] = double(g_variant_get_uint64(dev->config_get(sigrok::ConfigKey::LIMIT_SAMPLES).gobj()));
+					config["trigger_source"] = QString::fromUtf8(g_variant_get_string(dev->config_get(sigrok::ConfigKey::TRIGGER_SOURCE).gobj(), nullptr));
+					config["trigger_slope"] = QString::fromUtf8(g_variant_get_string(dev->config_get(sigrok::ConfigKey::TRIGGER_SLOPE).gobj(), nullptr));
+					config["pretrigger"] = g_variant_get_double(dev->config_get(sigrok::ConfigKey::HORIZ_TRIGGERPOS).gobj());
+				} catch (sigrok::Error& error) { config["error"] = error.what(); }
+				report["device_config"] = config;
+			}
+			report["channels"] = channels;
+			report["decoders"] = decoders;
+			QFile out(report_path);
+			if (out.open(QIODevice::WriteOnly)) out.write(QJsonDocument(report).toJson());
+			if (decoders.size() == 4) grab().save(report_path + ".png");
+		});
+		probe->start(1000);
