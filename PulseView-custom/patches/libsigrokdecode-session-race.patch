diff --git a/session.c b/session.c
index ad08407..94c0fc7 100644
--- a/session.c
+++ b/session.c
@@ -63,12 +63,16 @@ SRD_API int srd_session_new(struct srd_session **sess)
 	if (!sess)
 		return SRD_ERR_ARG;
 
+	/* Session lists are also read by Python decoder callbacks under the GIL.
+	 * PulseView creates several stacks from independent worker threads. */
+	PyGILState_STATE gstate = PyGILState_Ensure();
 	*sess = g_malloc(sizeof(struct srd_session));
 	(*sess)->session_id = ++max_session_id;
 	(*sess)->di_list = (*sess)->callbacks = NULL;
 
 	/* Keep a list of all sessions, so we can clean up as needed. */
 	sessions = g_slist_append(sessions, *sess);
+	PyGILState_Release(gstate);
 
 	srd_dbg("Creating session %d.", (*sess)->session_id);
 
@@ -366,8 +370,10 @@ SRD_API int srd_session_destroy(struct srd_session *sess)
 		srd_inst_free_all(sess);
 	if (sess->callbacks)
 		g_slist_free_full(sess->callbacks, g_free);
+	PyGILState_STATE gstate = PyGILState_Ensure();
 	sessions = g_slist_remove(sessions, sess);
 	g_free(sess);
+	PyGILState_Release(gstate);
 
 	srd_dbg("Destroyed session %d.", session_id);
 
